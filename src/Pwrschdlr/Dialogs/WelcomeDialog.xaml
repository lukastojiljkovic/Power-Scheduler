<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Pwrschdlr.Dialogs.WelcomeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource DefaultContentDialogStyle}"
    Title="Welcome to Pwrschdlr"
    PrimaryButtonText="Get started"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <Style x:Key="StepTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </ContentDialog.Resources>

    <StackPanel Spacing="20">
        <TextBlock
            TextWrapping="Wrap"
            Text="Pwrschdlr is a power scheduler without the vowels. It shuts down, restarts, sleeps, hibernates or signs out your PC when a timer runs out." />

        <Grid ColumnSpacing="14" RowSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <FontIcon Glyph="&#xE7E8;" Style="{StaticResource AccentGlyphStyle}" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="Pick what happens" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Style="{StaticResource StepTextStyle}" Text="Shut down, restart, sleep, hibernate or sign out." />
            </StackPanel>

            <FontIcon Grid.Row="1" Glyph="&#xE916;" Style="{StaticResource AccentGlyphStyle}" />
            <StackPanel Grid.Row="1" Grid.Column="1">
                <TextBlock Text="Pick when" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    Style="{StaticResource StepTextStyle}"
                    Text="In a while, or at a time of day. The countdown shows how much time is left." />
            </StackPanel>

            <FontIcon Grid.Row="2" Glyph="&#xE711;" Style="{StaticResource AccentGlyphStyle}" />
            <StackPanel Grid.Row="2" Grid.Column="1">
                <TextBlock Text="Change your mind" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    Style="{StaticResource StepTextStyle}"
                    Text="Cancel or postpone the timer at any time. You can close Pwrschdlr: it opens again shortly before the timer runs out, so you can still stop it." />
            </StackPanel>
        </Grid>

        <InfoBar
            IsOpen="True"
            IsClosable="False"
            Severity="Warning"
            Title="Save your work"
            Message="Shutting down, restarting and signing out close your apps. Save your work before the timer runs out." />

        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
            Pwrschdlr is free, open-source software provided as is, without warranty. By using it, you agree to the
            <Hyperlink NavigateUri="https://github.com/lukastojiljkovic/Power-Scheduler/blob/main/TERMS.md">Terms of Use</Hyperlink>. It doesn't collect any data; see the
            <Hyperlink NavigateUri="https://github.com/lukastojiljkovic/Power-Scheduler/blob/main/PRIVACY.md">privacy statement</Hyperlink>.
        </TextBlock>

        <CheckBox x:Name="DontShowAgainBox" Content="Don't show this again" />
    </StackPanel>
</ContentDialog>
