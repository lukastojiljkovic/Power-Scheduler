<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Pwrschdlr.Views.TimerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conditions="using:Pwrschdlr.Core.Conditions">

    <!-- A column with a MaxWidth sits off-center directly in a ScrollViewer, so a Grid centers it. -->
    <ScrollViewer>
        <Grid>
            <StackPanel MaxWidth="760" Padding="32,20,32,32" Spacing="4">
                <TextBlock Text="Timer" Style="{StaticResource TitleTextBlockStyle}" />

                <!-- The repeating schedule, when there is one -->
                <Grid x:Name="RepeatCard" Margin="0,16,0,0" Padding="16,12" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="RepeatTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="WrapWholeWords" />
                        <TextBlock x:Name="RepeatNext" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="RepeatEditButton" Content="Edit" Click="OnRepeatEditClick" />
                        <Button x:Name="RepeatRemoveButton" Content="Remove" Click="OnRepeatRemoveClick" />
                    </StackPanel>
                </Grid>

                <!-- Setting a timer -->
                <StackPanel x:Name="SetupPanel">
                    <TextBlock Text="What happens" Style="{StaticResource SettingsSectionHeaderStyle}" />
                    <GridView
                        x:Name="ActionList"
                        SelectionMode="Single"
                        ItemContainerStyle="{StaticResource ActionTileStyle}"
                        SelectionChanged="OnChoiceChanged"
                        AutomationProperties.Name="What happens" />
                    <TextBlock x:Name="UnavailableText" Style="{StaticResource SecondaryCaptionStyle}" Visibility="Collapsed" />

                    <TextBlock Text="When" Style="{StaticResource SettingsSectionHeaderStyle}" />
                    <Grid Style="{StaticResource CardStyle}" Padding="16,4,16,16" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <SelectorBar x:Name="WhenBar" SelectionChanged="OnWhenChanged">
                            <SelectorBarItem x:Name="InItem" Text="In a while" />
                            <SelectorBarItem x:Name="AtItem" Text="At a time" />
                            <SelectorBarItem x:Name="ConditionItem" Text="When something ends" />
                        </SelectorBar>

                        <StackPanel x:Name="InPanel" Grid.Row="1" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <NumberBox
                                    x:Name="HoursBox"
                                    Header="Hours"
                                    Width="132"
                                    Minimum="0"
                                    Maximum="23"
                                    SpinButtonPlacementMode="Compact"
                                    ValueChanged="OnDelayChanged" />
                                <NumberBox
                                    x:Name="MinutesBox"
                                    Header="Minutes"
                                    Width="132"
                                    Minimum="0"
                                    Maximum="59"
                                    SmallChange="5"
                                    SpinButtonPlacementMode="Compact"
                                    ValueChanged="OnDelayChanged" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="15 min" Tag="15" Click="OnPresetClick" />
                                <Button Content="30 min" Tag="30" Click="OnPresetClick" />
                                <Button Content="1 hour" Tag="60" Click="OnPresetClick" />
                                <Button Content="2 hours" Tag="120" Click="OnPresetClick" />
                                <Button Content="4 hours" Tag="240" Click="OnPresetClick" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="AtPanel" Grid.Row="1" Spacing="16" Visibility="Collapsed">
                            <TimePicker
                                x:Name="AtPicker"
                                Header="Time"
                                MinuteIncrement="1"
                                SelectedTimeChanged="OnTimeChanged" />
                            <ToggleSwitch x:Name="RepeatToggle" Header="Repeat" Toggled="OnRepeatToggled" />
                            <StackPanel x:Name="DaysPanel" Spacing="8" Visibility="Collapsed">
                                <TextBlock Text="Runs every week on the days you choose." Style="{StaticResource SecondaryCaptionStyle}" />
                                <StackPanel x:Name="DaysRow" Orientation="Horizontal" Spacing="6" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="ConditionPanel" Grid.Row="1" Spacing="6" Visibility="Collapsed">
                            <RadioButton x:Name="DownloadsChoice" Content="Downloads finish" GroupName="Condition" Checked="OnConditionChecked" />
                            <StackPanel x:Name="DownloadsPanel" Margin="28,0,0,12" Spacing="8">
                                <TextBlock x:Name="DownloadRule" Style="{StaticResource SecondaryCaptionStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="ThresholdBox" MinWidth="116" SelectionChanged="OnConditionChoiceChanged" AutomationProperties.Name="Less than" />
                                    <ComboBox x:Name="QuietBox" MinWidth="128" SelectionChanged="OnConditionChoiceChanged" AutomationProperties.Name="For" />
                                </StackPanel>
                                <TextBlock x:Name="DownloadReading" />
                            </StackPanel>

                            <RadioButton x:Name="AppChoice" Content="An app closes" GroupName="Condition" Checked="OnConditionChecked" />
                            <StackPanel x:Name="AppPanel" Margin="28,0,0,12" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox
                                        x:Name="AppBox"
                                        MinWidth="300"
                                        PlaceholderText="No apps are running"
                                        SelectionChanged="OnConditionChoiceChanged"
                                        AutomationProperties.Name="App">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="conditions:RunningApp">
                                                <StackPanel>
                                                    <TextBlock Text="{x:Bind Name}" />
                                                    <TextBlock Text="{x:Bind FileName}" Style="{StaticResource SecondaryCaptionStyle}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Content="Refresh" VerticalAlignment="Bottom" Click="OnRefreshAppsClick" />
                                </StackPanel>
                            </StackPanel>

                            <RadioButton x:Name="IdleChoice" Content="Nobody uses the PC" GroupName="Condition" Checked="OnConditionChecked" />
                            <StackPanel x:Name="IdlePanel" Margin="28,0,0,0" Spacing="8">
                                <TextBlock x:Name="IdleRule" Style="{StaticResource SecondaryCaptionStyle}" />
                                <ComboBox x:Name="IdleBox" MinWidth="128" SelectionChanged="OnConditionChoiceChanged" AutomationProperties.Name="No input for" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,24,0,0" Padding="20" Style="{StaticResource CardStyle}" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon x:Name="SummaryGlyph" FontSize="32" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="SummaryText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="WrapWholeWords" />
                            <TextBlock x:Name="SummaryDetail" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                        <Button
                            x:Name="StartButton"
                            Grid.Column="2"
                            Content="Start"
                            MinWidth="120"
                            Padding="20,8"
                            VerticalAlignment="Center"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnStartClick" />
                    </Grid>
                </StackPanel>

                <!-- A timer that's running -->
                <StackPanel x:Name="RunningPanel" Margin="0,24,0,0" Spacing="24" Visibility="Collapsed">
                    <Grid Width="320" Height="320" HorizontalAlignment="Center">
                        <Ellipse StrokeThickness="14" Stroke="{ThemeResource ControlStrongFillColorDisabledBrush}" />
                        <Path
                            x:Name="RingArc"
                            StrokeThickness="14"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            Stroke="{ThemeResource AccentFillColorDefaultBrush}" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                <FontIcon x:Name="RunningGlyph" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="RunningAction" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                            <TextBlock
                                x:Name="RemainingText"
                                HorizontalAlignment="Center"
                                FontSize="60"
                                FontWeight="SemiBold"
                                AutomationProperties.Name="Time left" />
                            <TextBlock x:Name="TargetText" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <Button x:Name="CancelButton" Content="Cancel timer" MinWidth="148" Style="{StaticResource AccentButtonStyle}" Click="OnCancelClick" />
                        <Button x:Name="PostponeButton" MinWidth="148" Click="OnPostponeClick" />
                    </StackPanel>

                    <InfoBar
                        x:Name="KeepsRunningBar"
                        MaxWidth="560"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Informational"
                        Title="You can close Pwrschdlr" />
                </StackPanel>

                <!-- Something being waited for -->
                <Grid x:Name="WaitingPanel" Margin="0,24,0,0" MaxWidth="560" Padding="24" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="WaitingTitle" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" TextWrapping="WrapWholeWords" />
                            <TextBlock x:Name="WaitingReading" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />
                            <TextBlock x:Name="WaitingProgress" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button x:Name="CancelWaitingButton" Content="Cancel" MinWidth="148" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Click="OnCancelWaitingClick" />
                        <TextBlock
                            Text="Keep Pwrschdlr open while it waits. You can minimize it."
                            Style="{StaticResource SecondaryCaptionStyle}"
                            HorizontalAlignment="Center"
                            TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
