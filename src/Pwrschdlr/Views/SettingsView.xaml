<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Pwrschdlr.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pwrschdlr.Controls">

    <!-- A column with a MaxWidth sits off-center directly in a ScrollViewer, so a Grid centers it. -->
    <ScrollViewer>
        <Grid>
            <StackPanel MaxWidth="760" Padding="32,20,32,32" Spacing="4">
                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

                <TextBlock Text="Timer" Style="{StaticResource SettingsSectionHeaderStyle}" />
                <controls:SettingsCard
                    Glyph="&#xEA8F;"
                    Header="Warn me before it happens"
                    Description="Pwrschdlr comes to the front and counts down, so you can still cancel or postpone. It opens for this even when it's closed.">
                    <ComboBox x:Name="WarningBox" MinWidth="200" SelectionChanged="OnWarningChanged" AutomationProperties.Name="Warn me before it happens" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Glyph="&#xE7BA;"
                    Header="Close apps without asking"
                    Description="When Windows shuts down, restarts or signs out, apps with unsaved work can't hold it up. Unsaved work is lost.">
                    <ToggleSwitch x:Name="CloseAppsToggle" Toggled="OnCloseAppsToggled" AutomationProperties.Name="Close apps without asking" />
                </controls:SettingsCard>

                <TextBlock Text="Appearance" Style="{StaticResource SettingsSectionHeaderStyle}" />
                <controls:SettingsCard Glyph="&#xE790;" Header="App theme" Description="Select which theme Pwrschdlr uses">
                    <ComboBox x:Name="ThemeBox" MinWidth="200" SelectionChanged="OnThemeChanged" AutomationProperties.Name="App theme">
                        <ComboBoxItem Content="Use system setting" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                </controls:SettingsCard>
                <controls:SettingsCard Glyph="&#xE82F;" Header="Show the welcome screen" Description="Explain what Pwrschdlr does when it starts">
                    <ToggleSwitch x:Name="WelcomeToggle" Toggled="OnWelcomeToggled" AutomationProperties.Name="Show the welcome screen" />
                </controls:SettingsCard>

                <TextBlock Text="Updates" Style="{StaticResource SettingsSectionHeaderStyle}" />
                <controls:SettingsCard
                    Glyph="&#xE895;"
                    Header="Check for updates automatically"
                    Description="Ask GitHub for the latest release when Pwrschdlr starts, at most once a day">
                    <ToggleSwitch x:Name="AutoUpdateToggle" Toggled="OnAutoUpdateToggled" AutomationProperties.Name="Check for updates automatically" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    Glyph="&#xE896;"
                    Header="Update check"
                    Description="Check now for a newer release">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateStatusText" VerticalAlignment="Center" />
                        <Button x:Name="CheckNowButton" Content="Check now" Click="OnCheckNowClick" />
                    </StackPanel>
                </controls:SettingsCard>

                <TextBlock Text="About" Style="{StaticResource SettingsSectionHeaderStyle}" />
                <controls:SettingsCard x:Name="AboutCard" Glyph="&#xE946;" Header="Pwrschdlr">
                    <StackPanel Orientation="Horizontal">
                        <HyperlinkButton Content="Website" NavigateUri="https://lukastojiljkovic.github.io/Power-Scheduler/" />
                        <HyperlinkButton Content="Source code" NavigateUri="https://github.com/lukastojiljkovic/Power-Scheduler" />
                        <HyperlinkButton Content="Terms of Use" NavigateUri="https://github.com/lukastojiljkovic/Power-Scheduler/blob/main/TERMS.md" />
                        <HyperlinkButton Content="Privacy" NavigateUri="https://github.com/lukastojiljkovic/Power-Scheduler/blob/main/PRIVACY.md" />
                    </StackPanel>
                </controls:SettingsCard>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
